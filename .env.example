# Local settings. Copy to .env (web/Compose) and backend/.env (API CLI).
NODE_ENV=development
PORT=4000
LISTEN_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DATABASE_URL=postgresql://gwl:replace-with-a-long-random-hex-password@localhost:5432/gwl
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback
GMAIL_ACCOUNT=mag8000bulkmeters@gmail.com
# Fallback values; persisted Configuration settings govern scheduled operation.
POLL_MINUTES=5
DISCOVERY_DAYS=30
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
